---
import "../../styles/global.css";
import cubsLogo from "../../assets/cubs-logo.webp";
import { getContact, getCleanWhatsappNumber } from "../../lib/keystatic";
import { ArrowUpRight, Share2, Globe } from "lucide-react";

const contact = await getContact();
const cleanPhone = getCleanWhatsappNumber(contact.whatsapp);
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CUBS Kids • Bento Grid</title>
    <meta
      name="description"
      content="Bright Wear for Little Adventurers • Pakaian Anak Usia 3-8 Tahun"
    />
  </head>
  <body class="bg-[#E4E8EE] min-h-screen text-stone-900 antialiased font-sans flex flex-col justify-center items-center py-6 sm:py-10 px-4 sm:px-6">
    
    <!-- Outer Board Container (Tightly Packed Bento Grid Canvas like reference) -->
    <div class="w-full max-w-[960px] space-y-4">
      
      <!-- Top Minimal Header -->
      <header class="flex items-center justify-between px-1">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-bold text-stone-600 hover:text-stone-900 transition-colors"
        >
          <Globe className="size-3.5 text-[#059669]" />
          <span>cubskids.co.id</span>
        </a>

        <div class="flex items-center gap-3">
          <a
            href="/links"
            class="text-xs font-semibold text-stone-500 hover:text-stone-900 transition-colors"
          >
            Mode List
          </a>
          <button
            id="share-btn"
            type="button"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-700 bg-white hover:bg-stone-50 px-3 py-1.5 rounded-full shadow-2xs border border-stone-300/80 active:scale-95 transition-all cursor-pointer"
          >
            <Share2 className="size-3 text-stone-500" />
            <span>Bagikan</span>
          </button>
        </div>
      </header>

      <!-- 4x3 BENTO GRID (Mathematical Geometrical Grid from Reference) -->
      <main class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4.5">
        
        <!-- ================= ROW 1 ================= -->

        <!-- 1. VOUCHER DISCOUNT TICKET (Row 1, Col 1) -->
        <a
          href="/promo"
          class="group bg-white rounded-3xl p-5 border border-stone-200/90 shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 flex flex-col justify-between relative overflow-hidden aspect-square sm:aspect-auto"
        >
          <div class="space-y-1">
            <span class="text-[10px] font-black tracking-widest uppercase text-[#059669]">
              UPGRADE DISCOUNT
            </span>
            <p class="text-xs text-stone-700 font-medium leading-snug">
              Klaim voucher bundling hemat pakaian si kecil.
            </p>
            <div class="text-3xl font-black text-[#059669] tracking-tight pt-1">
              40% OFF
            </div>
          </div>

          <!-- Ticket Cutout Perforation Line with Half-Circle Notches -->
          <div class="relative my-3">
            <div class="border-b-2 border-dashed border-stone-200 w-full"></div>
            <div class="absolute -left-8 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#E4E8EE]"></div>
            <div class="absolute -right-8 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#E4E8EE]"></div>
          </div>

          <!-- Bottom Barcode & Code -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[9px] font-bold text-stone-500 uppercase tracking-widest">
              <span>DISCOUNT CODE</span>
              <span class="text-stone-900 font-mono font-black">CUBS40</span>
            </div>
            <!-- Clean Authentic Barcode SVG -->
            <svg class="w-full h-6 text-stone-900" viewBox="0 0 150 24" fill="currentColor">
              <rect x="0" y="0" width="2" height="24"/>
              <rect x="4" y="0" width="3" height="24"/>
              <rect x="9" y="0" width="1" height="24"/>
              <rect x="12" y="0" width="4" height="24"/>
              <rect x="18" y="0" width="2" height="24"/>
              <rect x="22" y="0" width="3" height="24"/>
              <rect x="27" y="0" width="1" height="24"/>
              <rect x="30" y="0" width="5" height="24"/>
              <rect x="37" y="0" width="2" height="24"/>
              <rect x="41" y="0" width="3" height="24"/>
              <rect x="46" y="0" width="2" height="24"/>
              <rect x="50" y="0" width="4" height="24"/>
              <rect x="56" y="0" width="1" height="24"/>
              <rect x="59" y="0" width="3" height="24"/>
              <rect x="64" y="0" width="5" height="24"/>
              <rect x="71" y="0" width="2" height="24"/>
              <rect x="75" y="0" width="3" height="24"/>
              <rect x="80" y="0" width="1" height="24"/>
              <rect x="83" y="0" width="4" height="24"/>
              <rect x="89" y="0" width="2" height="24"/>
              <rect x="93" y="0" width="5" height="24"/>
              <rect x="100" y="0" width="2" height="24"/>
              <rect x="104" y="0" width="3" height="24"/>
              <rect x="109" y="0" width="1" height="24"/>
              <rect x="112" y="0" width="4" height="24"/>
              <rect x="118" y="0" width="2" height="24"/>
              <rect x="122" y="0" width="5" height="24"/>
              <rect x="129" y="0" width="1" height="24"/>
              <rect x="132" y="0" width="3" height="24"/>
              <rect x="137" y="0" width="4" height="24"/>
              <rect x="143" y="0" width="2" height="24"/>
              <rect x="147" y="0" width="3" height="24"/>
            </svg>
          </div>
        </a>

        <!-- 2. BRAND FONT & COLOR SWATCHES (Row 1, Col 2) -->
        <a
          href="/about"
          class="group bg-[#059669] text-white rounded-3xl p-5 shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 flex flex-col justify-between aspect-square"
        >
          <div class="space-y-0.5">
            <span class="text-sm font-bold tracking-tight text-emerald-100">CUBS font</span>
            <p class="text-[10px] text-emerald-200">identity</p>
          </div>

          <div class="text-6xl font-black tracking-tight my-2">
            Aa
          </div>

          <!-- Color Swatch Blocks (Reference Match: 4 Pill Rectangles) -->
          <div class="grid grid-cols-4 gap-1.5 pt-1">
            <div class="h-5 rounded-md bg-[#10B981]" title="Emerald Mint"></div>
            <div class="h-5 rounded-md bg-[#34D399]" title="Light Green"></div>
            <div class="h-5 rounded-md bg-[#FFFFFF]" title="Clean White"></div>
            <div class="h-5 rounded-md bg-[#0F172A]" title="Deep Slate"></div>
          </div>
        </a>

        <!-- 3. OUTDOOR STORE BLADE SIGNAGE PHOTO (Row 1, Col 3) -->
        <a
          href="/products"
          class="group rounded-3xl overflow-hidden shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 relative aspect-square bg-[#0F172A] flex items-center justify-center border border-stone-300/80"
        >
          <!-- Realistic Architectural Facade with Projecting Blade Sign -->
          <div class="absolute inset-0 bg-[#334155] flex flex-col justify-between p-4">
            <!-- Wall Architectural lines -->
            <div class="absolute inset-0 opacity-20 bg-[repeating-linear-gradient(90deg,#000,#000_20px,transparent_20px,transparent_40px)]"></div>
            
            <div class="relative z-10 w-full flex justify-end">
              <!-- Square Blade Sign projecting from building -->
              <div class="bg-white p-3 rounded-xl shadow-2xl border border-stone-200 w-24 h-24 flex flex-col items-center justify-center space-y-1.5 transform group-hover:scale-105 transition-transform duration-300">
                <img src={cubsLogo.src} alt="CUBS Logo Sign" class="w-14 h-auto object-contain" />
                <span class="text-[8px] font-black uppercase tracking-widest text-stone-800">OFFICIAL</span>
              </div>
            </div>

            <div class="relative z-10 text-[10px] text-stone-300 font-bold tracking-wider">
              FLAGSHIP SHOWROOM
            </div>
          </div>
        </a>

        <!-- 4. TOP-RIGHT PHOTO CLOSE-UP (Row 1, Col 4) -->
        <a
          href="/products"
          class="group rounded-3xl overflow-hidden shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 relative aspect-square bg-[#059669]"
        >
          <img
            src="/images/hero/hero-kaos.jpg"
            alt="Anak Aktif Bermain Ceria"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-108 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-stone-900/10 group-hover:bg-transparent transition-colors"></div>
        </a>

        <!-- ================= ROW 2 ================= -->

        <!-- 5. SMARTPHONE MOCKUP ON GREEN (Row 2, Col 1) -->
        <a
          href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent("Halo CS CUBS Kids, saya mau konsultasi ukuran baju anak usia 3-8 tahun.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-[#059669] rounded-3xl p-4 shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 flex flex-col justify-between relative overflow-hidden aspect-square"
        >
          <!-- Smartphone Display Edge Mockup (Identical to reference phone peaking) -->
          <div class="w-full h-full bg-[#0F172A] rounded-2xl p-2.5 border-2 border-stone-700 shadow-xl flex flex-col justify-between relative transform -translate-x-1 -translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform">
            <!-- Top Status Bar -->
            <div class="flex items-center justify-between text-[8px] text-stone-400 font-bold px-1">
              <span>11:52</span>
              <div class="w-3 h-1.5 rounded-2xs border border-stone-400 bg-emerald-400"></div>
            </div>

            <!-- App Grid on Phone Screen -->
            <div class="grid grid-cols-3 gap-2 p-1">
              <!-- CUBS App Icon -->
              <div class="flex flex-col items-center space-y-0.5">
                <div class="w-8 h-8 rounded-xl bg-white p-1 flex items-center justify-center shadow-md">
                  <img src={cubsLogo.src} alt="CUBS App" class="w-full h-full object-contain" />
                </div>
                <span class="text-[7px] text-stone-300 font-bold">CUBS</span>
              </div>

              <!-- Calendar Icon -->
              <div class="flex flex-col items-center space-y-0.5">
                <div class="w-8 h-8 rounded-xl bg-white text-stone-900 flex flex-col items-center justify-center shadow-md">
                  <span class="text-[6px] font-bold text-red-500 uppercase">SAT</span>
                  <span class="text-xs font-black -mt-0.5">07</span>
                </div>
                <span class="text-[7px] text-stone-300">Calendar</span>
              </div>

              <!-- WhatsApp CS Icon -->
              <div class="flex flex-col items-center space-y-0.5">
                <div class="w-8 h-8 rounded-xl bg-[#25D366] text-white flex items-center justify-center shadow-md text-sm">
                  💬
                </div>
                <span class="text-[7px] text-stone-300">Chat CS</span>
              </div>
            </div>

            <div class="px-1 text-[8px] text-emerald-400 font-bold">
              ● WhatsApp Online
            </div>
          </div>
        </a>

        <!-- 6. CENTER MINIMALIST BRAND LOGO CARD (Row 2, Col 2-3: Spans 2 Columns!) -->
        <a
          href="/"
          class="group sm:col-span-2 bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/90 shadow-2xs hover:shadow-lg hover:scale-[1.01] transition-all duration-300 flex flex-col items-center justify-center text-center space-y-3"
        >
          <img
            src={cubsLogo.src}
            alt="CUBS Kids Logo"
            class="w-32 sm:w-40 h-auto object-contain transform group-hover:scale-105 transition-transform duration-300"
          />
          <h2 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight lowercase">
            cubskids
          </h2>
        </a>

        <!-- 7. TALL RIGHT CARD: PRODUCT VERTICAL (Row 2 & 3, Col 4: Spans 2 Rows Tall!) -->
        <a
          href="/products"
          class="group sm:col-start-2 md:col-start-4 sm:row-start-3 md:row-start-2 md:row-span-2 bg-[#059669] text-white rounded-3xl p-6 shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 relative overflow-hidden flex flex-col justify-between items-center text-center"
        >
          <!-- Tall Bottle / Product Mockup in Center -->
          <div class="relative w-full flex-1 flex items-center justify-center my-2">
            <!-- Branded Clean White Bottle/Tumbler Mockup like reference bottle -->
            <div class="w-20 sm:w-24 h-56 sm:h-64 rounded-full bg-white shadow-2xl border-2 border-stone-200 flex flex-col items-center justify-between p-3 relative transform group-hover:scale-105 transition-transform duration-500">
              <!-- Bottle Cap -->
              <div class="w-10 h-3 rounded-md bg-stone-300 border border-stone-400"></div>
              
              <!-- Vertical Brand Logo Text on Bottle -->
              <div class="transform -rotate-90 flex items-center gap-2 tracking-tight">
                <img src={cubsLogo.src} alt="CUBS on Bottle" class="w-6 h-auto" />
                <span class="text-stone-900 font-black text-sm tracking-wider uppercase">cubskids</span>
              </div>

              <!-- Bottle Bottom Rim -->
              <div class="w-12 h-1 rounded-full bg-stone-200"></div>
            </div>
          </div>

          <div class="relative z-10 space-y-0.5 pt-2">
            <h3 class="font-black text-sm text-white tracking-tight">Koleksi Petualang</h3>
            <p class="text-[10px] text-emerald-100 font-medium">Baju Katun Adem 3-8 Thn</p>
          </div>
        </a>

        <!-- ================= ROW 3 ================= -->

        <!-- 8. FRAMED HORIZONTAL BILLBOARD MOCKUP (Row 3, Col 1-2: Spans 2 Columns!) -->
        <a
          href="/#why-cubs"
          class="group sm:col-span-2 bg-white rounded-3xl p-4 sm:p-5 border border-stone-200/90 shadow-2xs hover:shadow-lg hover:scale-[1.01] transition-all duration-300 flex flex-col justify-center"
        >
          <!-- Concrete/Wall Billboard Frame -->
          <div class="relative bg-stone-100 rounded-2xl p-4 sm:p-5 border-4 border-stone-300/80 shadow-md flex items-center justify-between gap-4 overflow-hidden">
            <!-- Poster Content -->
            <div class="space-y-2 max-w-xs">
              <div class="flex items-center gap-1.5">
                <img src={cubsLogo.src} alt="CUBS" class="w-7 h-auto" />
                <span class="text-[9px] font-black uppercase tracking-wider text-stone-700">KENAPA CUBS?</span>
              </div>
              <h3 class="text-sm sm:text-base font-black text-stone-900 leading-tight">
                100% Katun Combed 24s • Bebas Label Gatal di Leher
              </h3>
              <p class="text-[11px] text-stone-500 font-medium">
                Jahitan ganda kuat, aman dicuci mesin berkali-kali.
              </p>
            </div>

            <!-- Billboard Graphic/Visual -->
            <div class="w-24 sm:w-28 h-20 sm:h-24 rounded-xl overflow-hidden shrink-0 shadow-sm border border-stone-200">
              <img
                src="/images/hero/hero-dress.jpg"
                alt="Baju Katun Anak Nyaman"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
          </div>
        </a>

        <!-- 9. SOLID GREEN MISSION / SLOGAN TYPOGRAPHY (Row 3, Col 3) -->
        <a
          href="/products"
          class="group bg-[#059669] text-white rounded-3xl p-6 shadow-2xs hover:shadow-lg hover:scale-[1.02] transition-all duration-300 flex flex-col justify-center aspect-square text-center"
        >
          <div class="space-y-1">
            <h3 class="text-xl sm:text-2xl font-black leading-tight tracking-tight">
              Connecting<br />
              Little Ideas,<br />
              Empowering<br />
              Adventures
            </h3>
            <p class="text-[10px] text-emerald-200 font-bold pt-2 uppercase tracking-wider">
              CUBS Kids • 3-8 Thn
            </p>
          </div>
        </a>

      </main>

      <!-- Bottom Minimalist Marketplace Pills -->
      <footer class="flex items-center justify-between pt-2 px-1 text-xs text-stone-500">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-bold text-stone-600">Beli di:</span>
          <a
            href="https://shopee.co.id"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full bg-white hover:bg-stone-50 text-stone-800 border border-stone-300/80 font-bold text-[11px] shadow-2xs transition-colors"
          >
            Shopee Mall
          </a>
          <a
            href="https://tokopedia.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1 rounded-full bg-white hover:bg-stone-50 text-stone-800 border border-stone-300/80 font-bold text-[11px] shadow-2xs transition-colors"
          >
            Tokopedia
          </a>
        </div>

        <p class="text-[11px] text-stone-400">
          © 2026 CUBS Kids
        </p>
      </footer>

    </div>

    <!-- Script for Share Button -->
    <script is:inline>
      const shareBtn = document.getElementById("share-btn");
      if (shareBtn) {
        shareBtn.addEventListener("click", async () => {
          const shareData = {
            title: document.title,
            text: "Kunjungi Bento Grid resmi CUBS Kids!",
            url: window.location.href,
          };
          if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
            try {
              await navigator.share(shareData);
            } catch (e) {}
          } else if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href).then(() => {
              window.alert("Tautan Bento berhasil disalin!");
            });
          }
        });
      }
    </script>
  </body>
</html>
