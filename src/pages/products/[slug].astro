---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { ProductGallery } from "../../components/ProductGallery";
import {
  getProduct,
  getProducts,
  formatRupiah,
  CATEGORY_LABELS,
  AGE_LABELS,
  getProductImages,
  getContact,
  getCleanWhatsappNumber,
} from "../../lib/keystatic";
import {
  Star,
  ShoppingCart,
  ShieldCheck,
  Truck,
  RefreshCw,
  ArrowLeft,
  Share2,
  Heart,
  Sparkles,
  CheckCircle2,
  AlertCircle
} from "lucide-react";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/products");
}

const product = await getProduct(slug);
if (!product) {
  return Astro.redirect("/products");
}

const entry = product.entry;
const displayName = entry.name.replace(/-/g, " ");
const categoryName = CATEGORY_LABELS[entry.category] || entry.category;
const ageName = AGE_LABELS[entry.ageGroup] || entry.ageGroup;

const discountPercent =
  entry.originalPrice && entry.originalPrice > entry.price
    ? Math.round(((entry.originalPrice - entry.price) / entry.originalPrice) * 100)
    : null;

const contact = await getContact();
const defaultWa = getCleanWhatsappNumber(contact.whatsapp);

const waMessage = encodeURIComponent(
  `Halo CUBS Kids, saya mau pesan produk:\n- Nama: ${displayName}\n- Harga: ${formatRupiah(entry.price)}\n- Link: https://cubskids.co.id/products/${slug}\nMohon info ketersediaan stok & nomor rekening untuk pembayaran.`
);

let finalWaLink = `https://wa.me/${defaultWa}?text=${waMessage}`;
if (entry.whatsappLink && entry.whatsappLink.trim()) {
  const custom = entry.whatsappLink.trim();
  if (custom.startsWith("http://") || custom.startsWith("https://")) {
    finalWaLink = custom;
  } else {
    const digits = custom.replace(/[^0-9]/g, "");
    if (digits) {
      finalWaLink = `https://wa.me/${digits}?text=${waMessage}`;
    }
  }
}

const showWhatsapp = entry.showWhatsappButton !== false;
const waButtonText = entry.whatsappButtonText || "Pesan via WhatsApp Sekarang";
const marketplaceButtons = Array.isArray(entry.marketplaceButtons) ? entry.marketplaceButtons : [];
const productImages = getProductImages(entry);

// Related products
const allProducts = await getProducts();
const relatedProducts = allProducts
  .filter((p) => p.slug !== slug && (p.entry.category === entry.category || p.entry.featured))
  .slice(0, 4);
---

<Layout
  title={`${displayName} - CUBS Kids`}
  description={entry.summary || `Beli ${displayName} terbaik untuk anak di CUBS Kids.`}
>
  <div class="py-10 sm:py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl space-y-12">
      <!-- Breadcrumbs & Back Link -->
      <nav class="flex items-center text-xs sm:text-sm text-stone-500">
        <a
          href="/products"
          class="inline-flex items-center gap-1.5 font-semibold text-stone-700 hover:text-amber-700 transition-colors"
        >
          <ArrowLeft className="size-4" />
          <span>Kembali ke Katalog Produk</span>
        </a>
      </nav>

      <!-- Main Product Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        <!-- Left: Product Image Showcase (Multiple Sliding Images & Thumbnails) -->
        <div class="lg:col-span-6 space-y-4">
          <ProductGallery
            client:load
            images={productImages}
            productName={displayName}
            badge={entry.badge}
            discountPercent={discountPercent}
          />

          <!-- Feature Pills Under Image -->
          <div class="grid grid-cols-3 gap-3">
            <div class="rounded-2xl bg-white p-3 border border-amber-100 shadow-2xs text-center space-y-0.5">
              <span class="text-lg">🌬️</span>
              <p class="text-[11px] font-bold text-stone-800">100% Katun Adem</p>
              <p class="text-[10px] text-stone-500">Serap Keringat</p>
            </div>
            <div class="rounded-2xl bg-white p-3 border border-amber-100 shadow-2xs text-center space-y-0.5">
              <span class="text-lg">🏷️</span>
              <p class="text-[11px] font-bold text-stone-800">Bebas Label Gatal</p>
              <p class="text-[10px] text-stone-500">Tagless Comfort</p>
            </div>
            <div class="rounded-2xl bg-white p-3 border border-amber-100 shadow-2xs text-center space-y-0.5">
              <span class="text-lg">🔄</span>
              <p class="text-[11px] font-bold text-stone-800">Garansi Tukar Size</p>
              <p class="text-[10px] text-stone-500">7 Hari Tanpa Ribet</p>
            </div>
          </div>
        </div>

        <!-- Right: Product Info & Order CTA -->
        <div class="lg:col-span-6 space-y-6">
          <!-- Category & Age Group -->
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-100 px-3 py-1 rounded-full">
              {categoryName}
            </span>
            <span class="text-xs font-semibold text-stone-600 bg-stone-100 px-3 py-1 rounded-full">
              Usia: {ageName}
            </span>
            <span class="text-xs font-semibold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full">
              {entry.stockStatus === 'preorder' ? 'Pre-Order' : 'Ready Stock'}
            </span>
          </div>

          <!-- Product Title -->
          <h1 class="text-2xl sm:text-4xl font-black text-stone-900 tracking-tight leading-tight">
            {displayName}
          </h1>

          <!-- Rating & Sold Count -->
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5 text-amber-500">
              <Star className="size-4 fill-amber-400 stroke-amber-400" />
              <span class="text-sm font-bold text-stone-800">{entry.rating || "4.9"}</span>
            </div>
            <span class="text-stone-300">•</span>
            <span class="text-sm text-stone-500 font-medium">{entry.soldCount || 100}+ Terjual</span>
            <span class="text-stone-300">•</span>
            <span class="text-xs text-emerald-600 font-semibold flex items-center gap-1">
              <CheckCircle2 className="size-3.5" />
              <span>Stok Terverifikasi</span>
            </span>
          </div>

          <!-- Price Display -->
          <div class="rounded-3xl bg-[#FFF9EE] border border-amber-200/70 p-5 flex items-baseline gap-3">
            <span class="text-3xl sm:text-4xl font-black text-stone-900">
              {formatRupiah(entry.price)}
            </span>
            {entry.originalPrice && (
              <span class="text-sm sm:text-base text-stone-400 line-through">
                {formatRupiah(entry.originalPrice)}
              </span>
            )}
            {discountPercent && (
              <span class="text-xs font-bold text-rose-600 bg-rose-100 px-2.5 py-1 rounded-full">
                Hemat {formatRupiah(entry.originalPrice! - entry.price)}
              </span>
            )}
          </div>

          <!-- Material Guarantee Box -->
          {entry.material && (
            <div class="rounded-2xl bg-white border border-stone-200 p-4 space-y-1">
              <div class="flex items-center gap-2 text-stone-900 font-bold text-xs uppercase tracking-wider">
                <ShieldCheck className="size-4 text-emerald-600" />
                <span>Spesifikasi Material</span>
              </div>
              <p class="text-sm text-stone-700 font-medium">
                {entry.material}
              </p>
            </div>
          )}

          <!-- Short Summary -->
          {entry.summary && (
            <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
              {entry.summary}
            </p>
          )}

          <!-- Order Actions (WhatsApp & Online Shop Marketplaces) -->
          <div class="pt-2 space-y-3">
            {showWhatsapp && (
              <a
                href={finalWaLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2.5 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-base py-4 px-8 shadow-xs active:scale-98 transition-all"
              >
                <ShoppingCart className="size-5" />
                <span>{waButtonText}</span>
              </a>
            )}

            {marketplaceButtons.length > 0 && (
              <div class="space-y-2.5 pt-1">
                {showWhatsapp && (
                  <div class="relative flex py-1.5 items-center">
                    <div class="flex-grow border-t border-stone-200"></div>
                    <span class="flex-shrink mx-3 text-xs text-stone-400 font-semibold uppercase tracking-wider">
                      Atau Beli di Online Shop
                    </span>
                    <div class="flex-grow border-t border-stone-200"></div>
                  </div>
                )}

                <div class={`grid gap-2.5 ${marketplaceButtons.length > 1 ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1"}`}>
                  {marketplaceButtons.map((btn) => {
                    const platform = btn.platform || "custom";
                    const label = btn.label || "Beli Sekarang";
                    const url = btn.url || "#";

                    let bgStyle = "bg-stone-800 hover:bg-stone-900 text-white";
                    if (platform === "shopee") bgStyle = "bg-[#EE4D2D] hover:bg-[#D73211] text-white";
                    if (platform === "tokopedia") bgStyle = "bg-[#03AC0E] hover:bg-[#028A0B] text-white";
                    if (platform === "tiktok") bgStyle = "bg-stone-900 hover:bg-black text-white";
                    if (platform === "lazada") bgStyle = "bg-[#0F146D] hover:bg-[#090D4D] text-white";
                    if (platform === "blibli") bgStyle = "bg-[#0095DA] hover:bg-[#007BB5] text-white";

                    return (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`w-full inline-flex items-center justify-center gap-2 rounded-full font-bold text-sm py-3.5 px-5 shadow-xs transition-all active:scale-98 text-center ${bgStyle}`}
                      >
                        {platform === "shopee" && (
                          <svg class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24">
                            <path d="M19.5 7.5h-2.25A5.25 5.25 0 0 0 12 2.25a5.25 5.25 0 0 0-5.25 5.25H4.5A2.25 2.25 0 0 0 2.25 9.75l1.5 10.5A2.25 2.25 0 0 0 6 22.5h12a2.25 2.25 0 0 0 2.25-2.25l1.5-10.5a2.25 2.25 0 0 0-2.25-2.25zM12 3.75a3.75 3.75 0 0 1 3.75 3.75H8.25A3.75 3.75 0 0 1 12 3.75zm1.5 9.75c0 .41-.34.75-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5c.41 0 .75.34.75.75zm-3-2.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75z"/>
                          </svg>
                        )}
                        {platform === "tokopedia" && (
                          <svg class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24">
                            <path d="M12 2a4 4 0 0 0-4 4H5a2 2 0 0 0-2 2v11a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3V8a2 2 0 0 0-2-2h-3a4 4 0 0 0-4-4zm-2 4a2 2 0 1 1 4 0h-4zm-3 5a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm8 0a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm-7 4.5a5.5 5.5 0 0 0 8 0 .75.75 0 0 1 1.06 1.06 7 7 0 0 1-10.12 0 .75.75 0 0 1 1.06-1.06z"/>
                          </svg>
                        )}
                        {platform === "tiktok" && (
                          <svg class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24">
                            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.95-4.49V8.78a8.28 8.28 0 0 0 4.82 1.54V6.87a4.84 4.84 0 0 1-1-.18z"/>
                          </svg>
                        )}
                        {platform === "lazada" && (
                          <svg class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                          </svg>
                        )}
                        {platform === "blibli" && (
                          <svg class="size-4.5 shrink-0 fill-current" viewBox="0 0 24 24">
                            <path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h14v12zm-7-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                          </svg>
                        )}
                        {platform === "custom" && (
                          <svg class="size-4.5 shrink-0 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                          </svg>
                        )}
                        <span>{label}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            <p class="text-xs text-center text-stone-500">
              💬 Terhubung langsung dengan Customer Service CUBS untuk konfirmasi stok, ukuran & warna.
            </p>
          </div>

          <!-- Full Description Accordion / Box -->
          {entry.description && (
            <div class="pt-6 border-t border-stone-200 space-y-2">
              <h3 class="font-bold text-sm sm:text-base text-stone-900">
                Deskripsi Lengkap Produk
              </h3>
              <p class="text-sm text-stone-600 leading-relaxed whitespace-pre-line">
                {entry.description}
              </p>
            </div>
          )}
        </div>
      </div>

      <!-- Related Products Section -->
      {relatedProducts.length > 0 && (
        <div class="pt-16 border-t border-amber-200/60 space-y-8">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
              Produk Terkait untuk Si Kecil
            </h2>
            <p class="text-sm text-stone-600">
              Koleksi lain yang sering dipilih bersama produk ini.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {relatedProducts.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

