---
import Layout from "../../layouts/Layout.astro";
import { ProductCatalog } from "../../components/ProductCatalog";
import { getProducts, getContact } from "../../lib/keystatic";
import { Sparkles } from "lucide-react";

// Fetch all products & contact from Keystatic Reader
const products = await getProducts();
const contact = await getContact();
const initialCategory = Astro.url.searchParams.get("category") || "all";
---

<Layout
  title="Katalog Baju Anak Usia 3 - 8 Tahun - CUBS Kids"
  description="Koleksi lengkap pakaian anak usia 3 hingga 8 tahun: kaos katun combed adem, setelan piyama bambu sejuk, dress santai, dan jaket hoodie."
>
  <div class="py-10 sm:py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl space-y-8">
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-amber-200/60">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-semibold">
            <Sparkles className="size-3.5" />
            <span>Koleksi Pakaian Anak Usia 3 - 8 Tahun</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
            Katalog Baju Anak Ceria & Nyaman
          </h1>
          <p class="text-sm sm:text-base text-stone-600 max-w-xl">
            Tersedia Size 4 (3-4 Thn), Size 6 (5-6 Thn), dan Size 8 (7-8 Thn). Dibuat dari bahan katun murni yang sejuk, tahan cuci, dan bebas label leher gatal.
          </p>
        </div>
      </div>

      <!-- Interactive Catalog Component with Client Hydration -->
      <ProductCatalog
        client:load
        initialProducts={products}
        initialCategory={initialCategory}
        whatsappNumber={contact.whatsapp || undefined}
      />
    </div>
  </div>
</Layout>
