---
import "../../styles/global.css";
import cubsLogo from "../../assets/cubs-logo.webp";
import { getBioLinks, getContact, getCleanWhatsappNumber } from "../../lib/keystatic";
import {
  Share2,
  Check,
  ExternalLink,
  ChevronRight,
  BadgeCheck,
  MessageCircle,
  Globe,
  ShoppingBag,
  Sparkles,
} from "lucide-react";

// Fetch bio links configuration & contact details
const bioLinks = await getBioLinks();
const contact = await getContact();
const cleanPhone = getCleanWhatsappNumber(contact.whatsapp);

// Resolve profile avatar
const avatarSrc = bioLinks.avatarImage || cubsLogo.src;

// Resolve background theme color (Solid Pastels only - NO GRADIENT)
const THEME_CLASSES: Record<string, { bg: string; cardBg: string; text: string }> = {
  cream: { bg: "bg-[#FCFAF7]", cardBg: "bg-white", text: "text-stone-900" },
  mint: { bg: "bg-[#EBF7EE]", cardBg: "bg-white", text: "text-emerald-950" },
  butter: { bg: "bg-[#FFF9E6]", cardBg: "bg-white", text: "text-amber-950" },
  sky: { bg: "bg-[#F0F9FF]", cardBg: "bg-white", text: "text-sky-950" },
  pink: { bg: "bg-[#FDF0F4]", cardBg: "bg-white", text: "text-rose-950" },
};
const activeTheme = THEME_CLASSES[bioLinks.themeStyle || "cream"] || THEME_CLASSES.cream;

// Helper to resolve URLs (especially WhatsApp links to single source of truth)
function resolveLinkUrl(rawUrl: string): { url: string; isExternal: boolean } {
  const trimmed = (rawUrl || "").trim();
  if (trimmed.toLowerCase() === "whatsapp" || trimmed.toLowerCase() === "wa") {
    return { url: `https://wa.me/${cleanPhone}?text=${encodeURIComponent("Halo CUBS Kids, saya menghubungi dari Bio Linktree.")}`, isExternal: true };
  }
  if (trimmed.includes("wa.me/")) {
    const updated = trimmed.replace(/wa\.me\/\d+/, `wa.me/${cleanPhone}`);
    return { url: updated, isExternal: true };
  }
  const isExternal = trimmed.startsWith("http://") || trimmed.startsWith("https://");
  return { url: trimmed || "/", isExternal };
}

// Social icon links
const social = bioLinks.socialLinks || {};
const waSocialUrl = social.whatsapp && social.whatsapp.trim()
  ? (social.whatsapp.startsWith("http") ? social.whatsapp : `https://wa.me/${social.whatsapp.replace(/[^0-9]/g, "")}`)
  : `https://wa.me/${cleanPhone}?text=${encodeURIComponent("Halo CUBS Kids, saya menghubungi dari link bio media sosial.")}`;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{bioLinks.profileTitle || "CUBS Kids"} - Bio Links Official</title>
    <meta
      name="description"
      content={bioLinks.profileTagline || "Bright Wear for Little Adventurers • Pakaian Anak Usia 3-8 Tahun"}
    />
    <meta property="og:title" content={`${bioLinks.profileTitle || "CUBS Kids"} - Bio Links Official`} />
    <meta
      property="og:description"
      content={bioLinks.profileTagline || "Katalog baju anak, promo bundling, dan konsultasi ukuran via WhatsApp."}
    />
    <meta property="og:image" content={cubsLogo.src} />
    <meta property="og:type" content="website" />
  </head>
  <body class={`${activeTheme.bg} min-h-screen text-stone-800 antialiased font-sans selection:bg-amber-200 selection:text-amber-900 flex flex-col items-center justify-between py-6 px-4 sm:px-6`}>
    
    <!-- Top Action Bar (Share Button & Toast) -->
    <header class="w-full max-w-md flex items-center justify-between pt-2 pb-4">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-600 hover:text-stone-900 bg-white/80 hover:bg-white px-3 py-1.5 rounded-full border border-stone-200/80 shadow-2xs transition-all"
        title="Kembali ke Beranda Website"
      >
        <Globe className="size-3.5 text-emerald-600" />
        <span>cubskids.co.id</span>
      </a>

      <!-- Share Bio Button -->
      <button
        id="share-btn"
        type="button"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-700 hover:text-stone-900 bg-white hover:bg-stone-50 px-3.5 py-1.5 rounded-full border border-stone-200 shadow-2xs active:scale-95 transition-all cursor-pointer"
        aria-label="Bagikan Link Ini"
      >
        <Share2 className="size-3.5 text-stone-600" />
        <span>Bagikan</span>
      </button>
    </header>

    <!-- Center Bio Content Container -->
    <main class="w-full max-w-md flex-1 flex flex-col items-center space-y-6">
      
      <!-- Profile Header -->
      <div class="text-center space-y-3 flex flex-col items-center">
        <!-- Avatar Frame with Solid Border -->
        <div class="relative group">
          <div class="w-24 h-24 sm:w-26 sm:h-26 rounded-full bg-white p-1.5 border-2 border-emerald-400 shadow-md flex items-center justify-center overflow-hidden">
            <img
              src={avatarSrc}
              alt={bioLinks.profileTitle || "CUBS Kids"}
              class="w-full h-full object-contain rounded-full"
              loading="eager"
            />
          </div>
          {bioLinks.verifiedBadge && (
            <div
              class="absolute -bottom-1 -right-1 bg-emerald-500 text-white rounded-full p-1 shadow-sm border-2 border-white"
              title="Official Verified Account"
            >
              <BadgeCheck className="size-4.5 fill-white text-emerald-500" />
            </div>
          )}
        </div>

        <!-- Title & Handle -->
        <div class="space-y-1">
          <div class="inline-flex items-center justify-center gap-1.5">
            <h1 class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight">
              {bioLinks.profileTitle || "CUBS Kids Official"}
            </h1>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 font-medium max-w-xs sm:max-w-sm mx-auto leading-relaxed">
            {bioLinks.profileTagline || "Bright Wear for Little Adventurers 🐻 • Pakaian Anak Usia 3-8 Tahun"}
          </p>
        </div>

        <!-- Social Media Quick Row -->
        <div class="flex items-center justify-center gap-2 pt-1">
          {social.whatsapp !== null && (
            <a
              href={waSocialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white hover:bg-emerald-50 text-emerald-600 border border-emerald-200/90 shadow-2xs flex items-center justify-center hover:scale-110 active:scale-95 transition-all"
              title="Chat WhatsApp CS CUBS"
              aria-label="WhatsApp"
            >
              <MessageCircle className="size-4.5" />
            </a>
          )}
          {social.instagram && (
            <a
              href={social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white hover:bg-rose-50 text-rose-600 border border-rose-200/90 shadow-2xs flex items-center justify-center hover:scale-110 active:scale-95 transition-all"
              title="Instagram @cubskids"
              aria-label="Instagram"
            >
              <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>
          )}
          {social.tiktok && (
            <a
              href={social.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white hover:bg-stone-100 text-stone-900 border border-stone-200/90 shadow-2xs flex items-center justify-center hover:scale-110 active:scale-95 transition-all"
              title="TikTok @cubskids"
              aria-label="TikTok"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.86.12V9.42a6.34 6.34 0 0 0-.86-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 8.78 5.86 6.33 6.33 0 0 0 3.9-5.86V8.71a8.18 8.18 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.14z"/>
              </svg>
            </a>
          )}
          {social.shopee && (
            <a
              href={social.shopee}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white hover:bg-amber-50 text-amber-600 border border-amber-200/90 shadow-2xs flex items-center justify-center hover:scale-110 active:scale-95 transition-all"
              title="Shopee Official Store"
              aria-label="Shopee"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </a>
          )}
          {social.tokopedia && (
            <a
              href={social.tokopedia}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white hover:bg-emerald-50 text-emerald-700 border border-emerald-200/90 shadow-2xs flex items-center justify-center hover:scale-110 active:scale-95 transition-all"
              title="Tokopedia Official Store"
              aria-label="Tokopedia"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 12 2 2 4-4"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Links List (Linktree Cards) -->
      <div class="w-full space-y-3 pt-2">
        {(bioLinks.items || []).filter((item) => item.isActive !== false).map((item) => {
          const { url, isExternal } = resolveLinkUrl(item.url);
          const target = item.openInNewTab || isExternal ? "_blank" : undefined;
          const rel = target === "_blank" ? "noopener noreferrer" : undefined;

          // Solid pastel button styling rules
          let colorClasses = "bg-white hover:bg-stone-50 text-stone-900 border-stone-200 shadow-2xs";
          let iconBg = "bg-stone-100 text-stone-800";
          let badgeBg = "bg-stone-100 text-stone-700 border-stone-200";

          if (item.buttonColor === "emerald") {
            colorClasses = "bg-emerald-500 hover:bg-emerald-600 text-white border-emerald-600 shadow-sm";
            iconBg = "bg-white/20 text-white";
            badgeBg = "bg-white text-emerald-800 border-white";
          } else if (item.buttonColor === "butter") {
            colorClasses = "bg-[#FEF3C7] hover:bg-[#FDE68A] text-amber-950 border-amber-300 shadow-2xs";
            iconBg = "bg-white text-amber-900";
            badgeBg = "bg-amber-100 text-amber-900 border-amber-300";
          } else if (item.buttonColor === "sky") {
            colorClasses = "bg-[#E0F2FE] hover:bg-[#BAE6FD] text-sky-950 border-sky-300 shadow-2xs";
            iconBg = "bg-white text-sky-900";
            badgeBg = "bg-sky-100 text-sky-900 border-sky-300";
          } else if (item.buttonColor === "pink") {
            colorClasses = "bg-[#FCE7F3] hover:bg-[#FBCFE8] text-rose-950 border-rose-300 shadow-2xs";
            iconBg = "bg-white text-rose-900";
            badgeBg = "bg-rose-100 text-rose-900 border-rose-300";
          } else if (item.buttonColor === "dark") {
            colorClasses = "bg-stone-900 hover:bg-stone-800 text-white border-stone-950 shadow-sm";
            iconBg = "bg-stone-800 text-white";
            badgeBg = "bg-stone-800 text-amber-300 border-stone-700";
          }

          return (
            <a
              href={url}
              target={target}
              rel={rel}
              class={`group relative flex items-center justify-between p-3.5 sm:p-4 rounded-2xl border transition-all duration-200 active:scale-98 ${colorClasses} ${
                item.isHighlighted
                  ? "ring-3 ring-emerald-400/50 scale-[1.02] shadow-md"
                  : "hover:-translate-y-0.5 hover:shadow-md"
              }`}
            >
              <!-- Left: Emoji/Icon in cute pill -->
              <div class="flex items-center gap-3.5 min-w-0 flex-1">
                <div class={`w-11 h-11 shrink-0 rounded-xl flex items-center justify-center text-xl shadow-2xs transition-transform group-hover:scale-105 ${iconBg}`}>
                  {item.icon || "🔗"}
                </div>
                
                <!-- Center: Title and Subtitle -->
                <div class="min-w-0 flex-1 pr-2">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-extrabold text-sm sm:text-base leading-snug tracking-tight">
                      {item.title}
                    </h3>
                  </div>
                  {item.subtitle && (
                    <p class={`text-xs mt-0.5 leading-relaxed truncate ${item.buttonColor === "emerald" || item.buttonColor === "dark" ? "text-white/80" : "text-stone-500"}`}>
                      {item.subtitle}
                    </p>
                  )}
                </div>
              </div>

              <!-- Right: Optional Badge + Chevron Arrow -->
              <div class="flex items-center gap-2 shrink-0">
                {item.badge && (
                  <span class={`text-[10px] font-black uppercase px-2 py-0.5 rounded-full border tracking-wider ${badgeBg}`}>
                    {item.badge}
                  </span>
                )}
                <div class={`w-7 h-7 rounded-full flex items-center justify-center transition-transform group-hover:translate-x-0.5 ${item.buttonColor === "emerald" || item.buttonColor === "dark" ? "text-white/70" : "text-stone-400"}`}>
                  <ChevronRight className="size-4" />
                </div>
              </div>
            </a>
          );
        })}
      </div>

    </main>

    <!-- Footer Note -->
    <footer class="w-full max-w-md pt-8 pb-3 text-center space-y-2">
      <div class="flex items-center justify-center gap-1.5 text-xs text-stone-500 font-medium">
        <Sparkles className="size-3 text-amber-500" />
        <span>{bioLinks.footerNote || "CUBS Kids - Bright Wear for Little Adventurers"}</span>
      </div>
      <p class="text-[11px] text-stone-400">
        Pakaian Anak Usia 3 - 8 Tahun • Katun Combed 24s Adem & Bebas Gatal
      </p>
    </footer>

    <!-- Copy Toast Notification -->
    <div
      id="copy-toast"
      class="fixed bottom-6 z-50 bg-stone-900 text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-full shadow-xl border border-stone-800 flex items-center gap-2 opacity-0 pointer-events-none translate-y-3 transition-all duration-300"
      role="status"
    >
      <Check className="size-4 text-emerald-400" />
      <span>Tautan berhasil disalin ke clipboard!</span>
    </div>

    <!-- Client-side script for Native Share & Clipboard Copy -->
    <script is:inline>
      const shareBtn = document.getElementById("share-btn");
      const toast = document.getElementById("copy-toast");

      function showToast(msg) {
        if (!toast) return;
        if (msg) toast.querySelector("span").textContent = msg;
        toast.classList.remove("opacity-0", "pointer-events-none", "translate-y-3");
        toast.classList.add("opacity-100", "translate-y-0");
        setTimeout(() => {
          toast.classList.remove("opacity-100", "translate-y-0");
          toast.classList.add("opacity-0", "pointer-events-none", "translate-y-3");
        }, 2500);
      }

      if (shareBtn) {
        shareBtn.addEventListener("click", async () => {
          const shareData = {
            title: document.title,
            text: "Kunjungi bio link resmi CUBS Kids untuk promo bundling baju anak 3-8 tahun dan katalog lengkap!",
            url: window.location.href,
          };

          if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
            try {
              await navigator.share(shareData);
            } catch (err) {
              if (err.name !== "AbortError") {
                copyUrl();
              }
            }
          } else {
            copyUrl();
          }
        });
      }

      function copyUrl() {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href).then(() => {
            showToast("Tautan bio berhasil disalin!");
          }).catch(() => {
            fallbackPrompt();
          });
        } else {
          fallbackPrompt();
        }
      }

      function fallbackPrompt() {
        window.prompt("Salin link bio ini:", window.location.href);
      }
    </script>
  </body>
</html>
