---
import Layout from "../layouts/Layout.astro";
import { ShieldCheck, Heart, Sparkles, Award, ArrowRight, CheckCircle2, Users, Leaf, Smile } from "lucide-react";

const values = [
  {
    icon: Heart,
    title: "100% Katun Adem & Alami",
    desc: "Anak usia 3-8 tahun sangat aktif bergerak. Katun Combed 24s dan katun bambu pilihan kami menyerap keringat dengan cepat dan memberi sirkulasi udara optimal agar anak tidak gerah.",
    color: "bg-amber-100 text-amber-800",
  },
  {
    icon: ShieldCheck,
    title: "Bebas Label Leher Gatal (Tagless)",
    desc: "Tidak ada lagi drama anak rewel karena label kain di leher yang menusuk kulit. Semua baju CUBS didesain tagless dengan sablon leher halus tanpa rasa gatal.",
    color: "bg-rose-100 text-rose-800",
  },
  {
    icon: Leaf,
    title: "Sablon Ramah Anak (Non-Toxic)",
    desc: "Grafis dino, karakter ceria, dan warna pelangi dicetak menggunakan pewarna berbahan dasar air yang aman, ramah lingkungan, dan tidak retak meski dicuci mesin berulang kali.",
    color: "bg-emerald-100 text-emerald-800",
  },
  {
    icon: Smile,
    title: "Mudah Dipakai Mandiri",
    desc: "Mendukung kemandirian anak belajar berpakaian sendiri: kerah rib elastis yang mudah masuk kepala, celana dengan pinggang karet fleksibel, dan kancing yang mudah dibuka-tutup.",
    color: "bg-sky-100 text-sky-800",
  },
];

const milestones = [
  {
    year: "2021",
    title: "Awal Mula Sebuah Ide",
    desc: "Dimulai dari keresahan orang tua yang kesulitan menemukan baju anak usia 3-8 tahun yang adem, tidak cepat melar, dan bebas label leher gatal.",
  },
  {
    year: "2022",
    title: "Lini Pertama Kaos & Piyama",
    desc: "Meluncurkan koleksi kaos grafis katun combed dan setelan piyama bambu, langsung dipercaya oleh ratusan keluarga di kota-kota besar.",
  },
  {
    year: "2024",
    title: "Koleksi Lengkap 3-8 Tahun",
    desc: "Memperkenalkan size chart lengkap Size 4, Size 6, dan Size 8 mencakup dress anak perempuan, jaket hoodie, dan celana jogger stretch.",
  },
  {
    year: "Kini",
    title: "Dipercaya 10.000+ Orang Tua",
    desc: "Menjadi brand pilihan keluarga Indonesia untuk pakaian harian anak yang stylish, tahan banting, dan super nyaman.",
  },
];
---

<Layout
  title="Tentang CUBS Kids - Spesialis Baju Anak Usia 3 - 8 Tahun"
  description="Ketahui cerita di balik CUBS Kids: komitmen kami menghadirkan pakaian anak usia 3-8 tahun yang adem, bebas label gatal, dan kuat untuk aktivitas bermain si kecil."
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-20 px-4 sm:px-6">
    <div class="mx-auto max-w-4xl text-center space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 text-amber-900 border border-amber-300/60 px-4 py-1.5 text-xs sm:text-sm font-semibold shadow-xs">
        <Sparkles className="size-4 text-amber-600" />
        <span>Cerita & Komitmen Kualitas</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 leading-tight">
        Baju Nyaman & Bebas Gerah untuk <span class="text-emerald-700">Petualangan Usia 3 - 8 Tahun</span>
      </h1>

      <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl mx-auto">
        Di usia 3 sampai 8 tahun, anak sedang aktif-aktifnya berlari, melompat, dan belajar mandiri. Kami merancang pakaian yang siap menemani setiap gerak lincah mereka dengan penuh kenyamanan.
      </p>
    </div>
  </section>

  <!-- Story & Vision Section -->
  <section class="py-12 px-4 sm:px-6 bg-white border-y border-amber-100">
    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-5 relative">
          <div class="rounded-4xl bg-[#FEF9E6] p-8 text-center shadow-xs border border-amber-200/80">
            <div class="w-40 h-40 mx-auto rounded-full bg-white shadow-md flex items-center justify-center text-7xl mb-4">
              🧸
            </div>
            <h3 class="font-extrabold text-2xl text-stone-900 mb-1">Halo, Aku Cubby!</h3>
            <p class="text-xs text-amber-800 font-semibold bg-amber-200/60 rounded-full px-3 py-1 inline-block">
              Teman Petualangan Anak 3-8 Thn
            </p>
            <p class="text-xs text-stone-600 mt-3 leading-relaxed">
              "Aku beruang ceria yang menemani si kecil memakai baju sendiri, bermain di luar ruangan dengan gembira, dan tidur nyenyak di malam hari!"
            </p>
          </div>
        </div>

        <div class="md:col-span-7 space-y-5">
          <span class="text-xs font-bold text-amber-700 uppercase tracking-wider">Kisah Kami</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 leading-snug">
            Kenyamanan Tanpa Kompromi untuk Anak Usia Emas
          </h2>
          <p class="text-sm text-stone-600 leading-relaxed">
            Seringkali orang tua menghadapi anak yang rewel tidak mau memakai baju tertentu karena kainnya panas, sablonnya kaku, atau label di belakang leher yang gatal dan menusuk. Di iklim tropis Indonesia, anak-anak usia 3-8 tahun yang aktif bermain di luar mudah sekali berkeringat dan terkena biang keringat.
          </p>
          <p class="text-sm text-stone-600 leading-relaxed">
            CUBS hadir membawa solusi nyata: pakaian anak dengan bahan 100% Katun Combed 24s berpori adem, desain tagless bebas gatal leher, serta jahitan rantai ganda yang tidak gampang sobek saat anak lari dan memanjat.
          </p>
          <div class="pt-2 flex items-center gap-6">
            <div>
              <p class="text-2xl font-black text-amber-600">3 - 8 Thn</p>
              <p class="text-xs text-stone-500 font-medium">Fokus Usia Anak</p>
            </div>
            <div class="h-8 w-px bg-stone-200"></div>
            <div>
              <p class="text-2xl font-black text-amber-600">100%</p>
              <p class="text-xs text-stone-500 font-medium">Katun Adem & Tagless</p>
            </div>
            <div class="h-8 w-px bg-stone-200"></div>
            <div>
              <p class="text-2xl font-black text-amber-600">4.9 / 5.0</p>
              <p class="text-xs text-stone-500 font-medium">Kepuasan Orang Tua</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values Grid -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          4 Standar Utama Baju CUBS
        </h2>
        <p class="text-sm text-stone-600">
          Komitmen kami agar setiap helai pakaian membuat anak merasa bebas, percaya diri, dan bahagia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {values.map((v) => {
          const Icon = v.icon;
          return (
            <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md flex items-start gap-5 hover:shadow-lg transition-all">
              <div class={`w-14 h-14 rounded-2xl ${v.color} flex items-center justify-center shrink-0`}>
                <Icon className="size-7" />
              </div>
              <div class="space-y-1.5">
                <h3 class="font-bold text-lg text-stone-900">{v.title}</h3>
                <p class="text-sm text-stone-600 leading-relaxed">{v.desc}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Milestones Timeline -->
  <section class="py-16 px-4 sm:px-6 bg-[#F8FBF9] border-t border-emerald-100/70">
    <div class="mx-auto max-w-4xl space-y-10">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Perjalanan Kami Menemani Tumbuh Kembang Anak
        </h2>
        <p class="text-sm text-stone-600">
          Setia berinovasi menghadirkan pakaian anak Indonesia yang lebih sejuk dan tahan banting.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {milestones.map((m) => (
          <div class="rounded-3xl bg-white p-6 border border-amber-100 shadow-sm relative space-y-2">
            <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-800 font-extrabold text-xs">
              {m.year}
            </span>
            <h4 class="font-bold text-base text-stone-900">{m.title}</h4>
            <p class="text-xs text-stone-600 leading-relaxed">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-4xl rounded-4xl bg-stone-900 text-white p-8 sm:p-12 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black">
        Pilih Baju yang Pas untuk Buah Hati Anda (3-8 Thn)
      </h2>
      <p class="text-stone-300 text-sm max-w-lg mx-auto">
        Tersedia pilihan size chart Size 4, 6, dan 8 dengan garansi tukar ukuran 7 hari.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href="/products"
          class="w-full sm:w-auto rounded-full bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm px-8 py-3.5 shadow-md transition-all"
        >
          Lihat Katalog Baju Anak
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto rounded-full bg-stone-800 hover:bg-stone-700 text-white font-bold text-sm px-6 py-3.5 transition-colors"
        >
          Konsultasi Ukuran
        </a>
      </div>
    </div>
  </section>
</Layout>
