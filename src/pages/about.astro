---
import Layout from "../layouts/Layout.astro";
import { ShieldCheck, Heart, Sparkles, Award, ArrowRight, CheckCircle2, Users, Leaf, Smile } from "lucide-react";

const values = [
  {
    icon: ShieldCheck,
    title: "100% Sertifikasi Aman",
    desc: "Semua pakaian, silikon makan, dan mainan kayu kami telah lulus uji SNI, OEKO-TEX Standard 100 Class 1, dan FDA Food-Grade. Nol timbal, BPA, maupun ftalat.",
    color: "bg-amber-100 text-amber-800",
  },
  {
    icon: Heart,
    title: "Ramah Kulit Sensitif",
    desc: "Kami memahami betapa rentannya kulit bayi terhadap biang keringat dan eksim. Serat katun bambu pilihan kami memberi sirkulasi udara maksimal dan efek sejuk alami.",
    color: "bg-rose-100 text-rose-800",
  },
  {
    icon: Leaf,
    title: "Berkelanjutan (Eco-Friendly)",
    desc: "Masa depan anak kita bergantung pada bumi yang sehat. Kami memprioritaskan material terbarukan, kemasan tanpa plastik sekali pakai, dan pewarna ramah lingkungan.",
    color: "bg-emerald-100 text-emerald-800",
  },
  {
    icon: Smile,
    title: "Desain Berpusat Pada Anak",
    desc: "Potongan baju yang pas untuk bergerak lincah, kancing snap praktis untuk ganti popok cepat, dan mainan dengan sudut membulat tanpa resiko melukai si kecil.",
    color: "bg-sky-100 text-sky-800",
  },
];

const milestones = [
  {
    year: "2021",
    title: "Awal Mula Sebuah Ide",
    desc: "Dimulai dari keresahan sepasang orang tua yang kesulitan mencari piyama bayi yang adem dan tidak memicu ruam kulit di iklim tropis.",
  },
  {
    year: "2022",
    title: "Sertifikasi OEKO-TEX & SNI",
    desc: "Meluncurkan lini pertama piyama katun bambu bersertifikasi resmi, langsung dipercaya oleh lebih dari 500 keluarga di Jabodetabek.",
  },
  {
    year: "2024",
    title: "Ekspansi Mainan & Perlengkapan",
    desc: "Memperkenalkan lini mainan edukasi kayu Montessori dan feeding set silikon makanan tahan banting bebas BPA.",
  },
  {
    year: "Kini",
    title: "Dipercaya 10.000+ Orang Tua",
    desc: "Menjadi pilihan utama orang tua Indonesia untuk kebutuhan harian dan hampers kado lahiran berkualitas tinggi.",
  },
];
---

<Layout
  title="Tentang CUBS Kids - Dedikasi Keamanan & Kasih Sayang untuk Si Buah Hati"
  description="Ketahui cerita di balik CUBS Kids: komitmen kami menghadirkan produk anak dan bayi dengan standar keamanan terbaik, hypoallergenic, dan ramah lingkungan."
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-20 px-4 sm:px-6">
    <div class="mx-auto max-w-4xl text-center space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 text-amber-900 border border-amber-300/60 px-4 py-1.5 text-xs sm:text-sm font-semibold shadow-xs">
        <Sparkles className="size-4 text-amber-600" />
        <span>Cerita & Nilai Kami</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 leading-tight">
        Lahir dari Rasa Cinta & Perlindungan Terbaik untuk <span class="text-transparent bg-clip-text bg-linear-to-r from-amber-500 to-orange-500">Si Buah Hati</span>
      </h1>

      <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl mx-auto">
        Setiap produk yang kami buat diuji dengan satu pertanyaan sederhana: <em>"Apakah ini cukup aman, nyaman, dan menyenangkan untuk anak kita sendiri?"</em>
      </p>
    </div>
  </section>

  <!-- Story & Vision Section -->
  <section class="py-12 px-4 sm:px-6 bg-white border-y border-amber-100">
    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-5 relative">
          <div class="rounded-4xl bg-linear-to-tr from-amber-100 to-orange-100 p-8 text-center shadow-xl border border-amber-200">
            <div class="w-40 h-40 mx-auto rounded-full bg-white shadow-md flex items-center justify-center text-7xl mb-4">
              🧸
            </div>
            <h3 class="font-extrabold text-2xl text-stone-900 mb-1">Halo, Aku Cubby!</h3>
            <p class="text-xs text-amber-800 font-semibold bg-amber-200/60 rounded-full px-3 py-1 inline-block">
              Maskot Kebanggaan CUBS
            </p>
            <p class="text-xs text-stone-600 mt-3 leading-relaxed">
              "Aku beruang penyayang yang bertugas memastikan setiap tidur si kecil lelap dan setiap waktu bermain selalu ceria & aman!"
            </p>
          </div>
        </div>

        <div class="md:col-span-7 space-y-5">
          <span class="text-xs font-bold text-amber-700 uppercase tracking-wider">Kisah Kami</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 leading-snug">
            Standar Kualitas Tertinggi untuk Senyuman Masa Kecil
          </h2>
          <p class="text-sm text-stone-600 leading-relaxed">
            CUBS didirikan dengan satu komitmen mendasar: tidak pernah berkompromi pada kualitas bahan yang bersentuhan langsung dengan kulit dan mulut si kecil. Di pasaran, kami kerap menemukan produk anak dengan warna mencolok namun menggunakan pewarna kimia berbahaya atau kain sintetis yang memicu biang keringat.
          </p>
          <p class="text-sm text-stone-600 leading-relaxed">
            Itulah mengapa seluruh pakaian tidur dan bermain kami memakai katun bambu bersertifikasi OEKO-TEX Class 1. Untuk perlengkapan makan, kami hanya menggunakan 100% Platinum Food Grade Silicone yang dapat disteril suhu tinggi tanpa melepaskan zat beracun.
          </p>
          <div class="pt-2 flex items-center gap-6">
            <div>
              <p class="text-2xl font-black text-amber-600">10.000+</p>
              <p class="text-xs text-stone-500 font-medium">Keluarga Bahagia</p>
            </div>
            <div class="h-8 w-px bg-stone-200"></div>
            <div>
              <p class="text-2xl font-black text-amber-600">100%</p>
              <p class="text-xs text-stone-500 font-medium">Bahan Non-Toxic</p>
            </div>
            <div class="h-8 w-px bg-stone-200"></div>
            <div>
              <p class="text-2xl font-black text-amber-600">4.9 / 5.0</p>
              <p class="text-xs text-stone-500 font-medium">Rata-rata Ulasan</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values Grid -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          4 Pilar Utama CUBS
        </h2>
        <p class="text-sm text-stone-600">
          Janji kami kepada setiap orang tua yang mempercayakan produk kami kepada anaknya.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {values.map((v) => {
          const Icon = v.icon;
          return (
            <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md flex items-start gap-5 hover:shadow-lg transition-all">
              <div class={`w-14 h-14 rounded-2xl ${v.color} flex items-center justify-center shrink-0`}>
                <Icon className="size-7" />
              </div>
              <div class="space-y-1.5">
                <h3 class="font-bold text-lg text-stone-900">{v.title}</h3>
                <p class="text-sm text-stone-600 leading-relaxed">{v.desc}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Milestones Timeline -->
  <section class="py-16 px-4 sm:px-6 bg-linear-to-b from-amber-50/50 to-orange-50/50 border-t border-amber-100">
    <div class="mx-auto max-w-4xl space-y-10">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Perjalanan Tumbuh Kami Bersama Bunda & Ayah
        </h2>
        <p class="text-sm text-stone-600">
          Langkah demi langkah dalam menghadirkan standar produk anak yang lebih baik di Indonesia.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {milestones.map((m) => (
          <div class="rounded-3xl bg-white p-6 border border-amber-100 shadow-sm relative space-y-2">
            <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-800 font-extrabold text-xs">
              {m.year}
            </span>
            <h4 class="font-bold text-base text-stone-900">{m.title}</h4>
            <p class="text-xs text-stone-600 leading-relaxed">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-4xl rounded-4xl bg-stone-900 text-white p-8 sm:p-12 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black">
        Ingin Melihat Produk-Produk Ramah Anak Kami?
      </h2>
      <p class="text-stone-300 text-sm max-w-lg mx-auto">
        Koleksi lengkap pakaian piyama bambu, mainan edukasi, dan perlengkapan MPASI siap menemani keluarga Anda.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href="/products"
          class="w-full sm:w-auto rounded-full bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm px-8 py-3.5 shadow-md transition-all"
        >
          Buka Katalog Produk
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto rounded-full bg-stone-800 hover:bg-stone-700 text-white font-bold text-sm px-6 py-3.5 transition-colors"
        >
          Hubungi Tim Kami
        </a>
      </div>
    </div>
  </section>
</Layout>

