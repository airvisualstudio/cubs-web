---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { HeroSlider } from "../components/HeroSlider";
import { FaqSection } from "../components/FaqSection";
import { getProducts } from "../lib/keystatic";
import {
  Sparkles,
  ArrowRight,
  ShieldCheck,
  Heart,
  CheckCircle2,
  Star,
  ShoppingBag,
  Award,
} from "lucide-react";

// Fetch products from Keystatic
const allProducts = await getProducts();
const featuredProducts = allProducts.filter((p) => p.entry.featured).slice(0, 4);

// Categories for kids 3-8 years in clean solid pastels
const categories = [
  {
    title: "Kaos & Atasan",
    desc: "Katun combed 24s adem, sablon awet & tahan cuci",
    icon: "🦖",
    href: "/products?category=atasan",
    bg: "bg-[#F0F9FF] border-[#BAE6FD] text-sky-900",
  },
  {
    title: "Setelan & Piyama",
    desc: "Katun bambu sejuk alami bikin tidur anak nyenyak",
    icon: "⭐",
    href: "/products?category=setelan",
    bg: "bg-[#FFFDF5] border-[#FDE68A] text-amber-900",
  },
  {
    title: "Dress & Terusan",
    desc: "Gaun katun manis dan mengembang ceria saat berputar",
    icon: "👗",
    href: "/products?category=dress",
    bg: "bg-[#FDF2F8] border-[#FBCFE8] text-rose-900",
  },
  {
    title: "Jaket & Celana",
    desc: "Hoodie hangat & jogger stretch untuk anak yang aktif",
    icon: "🧥",
    href: "/products?category=bawahan-outer",
    bg: "bg-[#F0FDF4] border-[#BBF7D0] text-emerald-900",
  },
];

const testimonials = [
  {
    name: "Bunda Rini",
    role: "Ibu dari Kenzo (4 Tahun)",
    city: "Jakarta Barat",
    avatar: "👩",
    rating: 5,
    text: "Kaos dino-nya beneran favorit Kenzo! Sablonnya ga retak walau udah dicuci berkali-kali di mesin cuci. Bahannya adem banget dipakai lari-larian di playground.",
  },
  {
    name: "Ayah Fajar",
    role: "Ayah dari Aluna (6 Tahun)",
    city: "Bandung",
    avatar: "👨",
    rating: 5,
    text: "Dress twirl pelangi buat Aluna pas banget di badan. Bahannya jatuh dan jahitan kerahnya rapi, ga ada label gatal di leher jadi anaknya betah pakai seharian.",
  },
  {
    name: "Bunda Melly",
    role: "Ibu dari Zidan (7 Tahun)",
    city: "Tangerang Selatan",
    avatar: "👩‍🦰",
    rating: 5,
    text: "Celana jogger sama hoodie zipper-nya bahannya tebel tapi ga gerah. Anakku yang aktif manjat-manjat ga ngeluh sesak karena karet pinggangnya elastis empuk.",
  },
];
---

<Layout
  title="CUBS Kids - Koleksi Baju Anak Ceria Usia 3 - 8 Tahun"
  description="Koleksi pakaian anak usia 3 hingga 8 tahun berbahan 100% katun combed dan katun bambu yang adem, bebas gatal, dan kuat untuk aktivitas bermain si kecil."
>
  <!-- Top Hero Image Slider with Captions, Badges, & Action Buttons -->
  <section class="pt-2 sm:pt-4 pb-8 sm:pb-12">
    <HeroSlider client:load />
  </section>

  <!-- Categories Section -->
  <section class="py-12 px-4 sm:px-6 bg-white border-y border-amber-100">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Kategori Pilihan Baju Anak (3-8 Thn)
        </h2>
        <p class="text-sm text-stone-600">
          Dari pakaian harian santai, setelan piyama sejuk, hingga dress cantik siap jalan-jalan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {categories.map((c) => (
          <a
            href={c.href}
            class={`group relative rounded-3xl p-6 border transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block ${c.bg}`}
          >
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">
              {c.icon}
            </div>
            <h3 class="font-bold text-lg text-stone-900 mb-1 flex items-center justify-between">
              <span>{c.title}</span>
              <ArrowRight className="size-4 opacity-0 group-hover:opacity-100 transition-opacity" />
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              {c.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products Section (From Keystatic) -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 bg-amber-100 px-3 py-1 rounded-full">
            <Sparkles className="size-3.5" />
            <span>Katalog Terbaru (Usia 3-8 Thn)</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
            Baju Pilihan Favorit Anak
          </h2>
          <p class="text-sm text-stone-600">
            Dikelola & dapat diupdate langsung via Keystatic CMS.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/products"
            class="inline-flex items-center gap-2 rounded-full bg-stone-900 hover:bg-stone-800 text-white text-xs sm:text-sm font-semibold px-5 py-2.5 transition-colors"
          >
            <span>Lihat Semua Katalog</span>
            <ArrowRight className="size-4" />
          </a>
        </div>
      </div>

      <!-- Grid of Featured Products -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Parents Choose CUBS for 3-8y -->
  <section class="py-16 px-4 sm:px-6 bg-[#F8FBF9] border-y border-emerald-100/70">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-semibold">
          <Award className="size-3.5" />
          <span>Kualitas Teruji untuk Anak Aktif</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Kenapa Baju CUBS Paling Pas untuk Usia 3 - 8 Tahun?
        </h2>
        <p class="text-sm text-stone-600">
          Anak usia 3-8 tahun sangat aktif berlari, melompat, dan bereksplorasi. Bajunya harus nyaman dan kuat!
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-2xl">
            🌬️
          </div>
          <h3 class="font-bold text-lg text-stone-900">Serat Katun Menyerap Keringat</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Terbuat dari 100% Katun Combed 24s dan katun bambu berkualitas tinggi yang sejuk di badan anak, mencegah biang keringat meski bermain seharian di bawah terik matahari.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-800 flex items-center justify-center text-2xl">
            🏷️
          </div>
          <h3 class="font-bold text-lg text-stone-900">Bebas Label Leher Gatal (Tagless)</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Banyak anak menolak memakai baju karena label kain di belakang leher menusuk. Semua baju CUBS menggunakan sablon leher halus tanpa label fisik yang membuat gatal.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-sky-100 text-sky-800 flex items-center justify-center text-2xl">
            💪
          </div>
          <h3 class="font-bold text-lg text-stone-900">Jahitan Rantai Kuat & Elastis</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Jahitan ganda di bagian kerah, pundak, dan selangkangan celana menjamin baju tidak gampang sobek atau melar meski sering dicuci dan ditarik-tarik saat anak bermain aktif.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Parent Testimonials -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-xl mx-auto mb-12 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Ulasan Bunda & Ayah Bersama CUBS
        </h2>
        <p class="text-sm text-stone-600">
          Pengalaman nyata para orang tua dengan buah hati usia 3 - 8 tahun.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="rounded-3xl bg-white p-6 border border-amber-100 shadow-md flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center gap-1 text-amber-400">
                {Array.from({ length: t.rating }).map(() => (
                  <Star className="size-4 fill-amber-400 stroke-amber-400" />
                ))}
              </div>
              <p class="text-sm text-stone-700 italic leading-relaxed">
                "{t.text}"
              </p>
            </div>

            <div class="flex items-center gap-3 pt-5 mt-4 border-t border-stone-100">
              <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-lg">
                {t.avatar}
              </div>
              <div>
                <h4 class="font-bold text-sm text-stone-900">{t.name}</h4>
                <p class="text-xs text-stone-500">{t.role} • {t.city}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section (Radix UI Accordion) -->
  <section class="py-16 px-4 sm:px-6 bg-white border-t border-amber-100">
    <FaqSection client:load />
  </section>

  <!-- Final CTA Banner: Solid Pastel Yellow & Green Button -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl rounded-3xl sm:rounded-4xl bg-[#FEF3C7] border border-amber-200 p-8 sm:p-12 text-stone-900 shadow-sm text-center space-y-5">
      <span class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-amber-200/90 text-amber-950 text-xs font-bold uppercase tracking-wider">
        ✨ Temukan Ukuran yang Pas untuk Si Kecil (3-8 Thn)
      </span>

      <h2 class="text-3xl sm:text-4xl font-black max-w-xl mx-auto leading-tight text-stone-900">
        Siap Beri Baju Paling Nyaman untuk Aktivitas Si Kecil?
      </h2>

      <p class="text-sm sm:text-base text-stone-700 max-w-lg mx-auto">
        Tersedia Size 4, Size 6, dan Size 8 dengan garansi tukar ukuran 7 hari tanpa ribet.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href="/products"
          class="w-full sm:w-auto rounded-full bg-stone-900 hover:bg-stone-800 text-white font-bold text-sm px-8 py-3.5 shadow-xs active:scale-98 transition-all"
        >
          Lihat Katalog Baju Anak
        </a>
        <a
          href="https://wa.me/6281234567890?text=Halo%20CUBS,%20saya%20mau%20konsultasi%20size%20chart%20baju%20anak"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm px-8 py-3.5 shadow-xs active:scale-98 transition-all"
        >
          Konsultasi Size via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
