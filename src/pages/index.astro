---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { FaqSection } from "../components/FaqSection";
import { getProducts } from "../lib/keystatic";
import {
  Sparkles,
  ArrowRight,
  ShieldCheck,
  Heart,
  Baby,
  Smile,
  CheckCircle2,
  Star,
  ShoppingBag,
  Award,
} from "lucide-react";

// Fetch products from Keystatic
const allProducts = await getProducts();
const featuredProducts = allProducts.filter((p) => p.entry.featured).slice(0, 4);

// Categories
const categories = [
  {
    title: "Pakaian & Setelan",
    desc: "Katun bambu organik adem & bebas gatal",
    icon: "👕",
    href: "/products?category=pakaian",
    bg: "bg-sky-50 border-sky-200/80 text-sky-800",
  },
  {
    title: "Mainan & Edukasi",
    desc: "Montessori kayu halus & boneka plush",
    icon: "🎨",
    href: "/products?category=mainan",
    bg: "bg-amber-50 border-amber-200/80 text-amber-800",
  },
  {
    title: "Perlengkapan Bayi",
    desc: "Silikon food grade BPA-Free & anti tumpah",
    icon: "🍼",
    href: "/products?category=perlengkapan",
    bg: "bg-rose-50 border-rose-200/80 text-rose-800",
  },
  {
    title: "Sepatu & Aksesoris",
    desc: "Prewalker fleksibel & topi UV protektif",
    icon: "👟",
    href: "/products?category=aksesoris",
    bg: "bg-emerald-50 border-emerald-200/80 text-emerald-800",
  },
];

const testimonials = [
  {
    name: "Bunda Ayu",
    role: "Ibu dari Keenan (18 Bulan)",
    city: "Jakarta Selatan",
    avatar: "👩",
    rating: 5,
    text: "Piyama katun bambunya beneran sejuk banget! Anakku yang biasanya suka garuk-garuk leher pas tidur sekarang pules semalaman. Bahannya stretch dan cucian berulang kali ga melar.",
  },
  {
    name: "Ayah Dimas",
    role: "Ayah dari Arka (2 Tahun)",
    city: "Bandung",
    avatar: "👨",
    rating: 5,
    text: "Balok susun Montessori-nya halus parah, ga ada serpihan kayu tajam sama sekali. Warnanya juga cerah tapi ga berbau cat kimia. Aman banget buat main seharian.",
  },
  {
    name: "Bunda Citra",
    role: "Ibu dari Olivia (8 Bulan)",
    city: "Surabaya",
    avatar: "👩‍🦰",
    rating: 5,
    text: "Sippy cup silikonnya beneran anti tumpah walaupun sering dilempar dari high chair. Pelayanan admin WhatsApp-nya ramah dan pengiriman super cepat!",
  },
];
---

<Layout title="CUBS Kids - Sahabat Tumbuh Kembang Si Buah Hati">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-12 sm:py-20 px-4 sm:px-6">
    <!-- Background playful glow circles -->
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full bg-amber-200/40 blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-48 right-10 w-72 h-72 rounded-full bg-rose-200/30 blur-3xl -z-10"></div>

    <div class="mx-auto max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <!-- Playful Badge -->
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 text-amber-900 border border-amber-300/60 px-4 py-1.5 text-xs sm:text-sm font-semibold shadow-xs">
            <span class="text-base">🧸</span>
            <span>Koleksi Produk Anak Bersertifikasi SNI & OEKO-TEX</span>
          </div>

          <!-- Main Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 leading-[1.12]">
            Kenyamanan & Keceriaan Terbaik untuk <span class="text-transparent bg-clip-text bg-linear-to-r from-amber-500 via-orange-500 to-rose-500">Si Buah Hati</span>
          </h1>

          <!-- Description -->
          <p class="text-base sm:text-lg text-stone-600 max-w-2xl leading-relaxed mx-auto lg:mx-0">
            Didesain khusus bersama para orang tua: pakaian katun bambu yang ramah kulit sensitif, mainan edukasi kayu bersudut tumpul, hingga perlengkapan makan silikon platinum bebas BPA.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
            <a
              href="/products"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-linear-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold text-sm sm:text-base px-8 py-3.5 shadow-lg shadow-orange-500/25 active:scale-98 transition-all"
            >
              <ShoppingBag className="size-5" />
              <span>Lihat Katalog Produk</span>
              <ArrowRight className="size-4" />
            </a>

            <a
              href="/about"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-white hover:bg-stone-50 text-stone-800 font-bold text-sm sm:text-base px-6 py-3.5 border border-stone-200 shadow-xs transition-colors"
            >
              <span>Cerita Kami</span>
            </a>
          </div>

          <!-- Trust Badges List -->
          <div class="pt-4 grid grid-cols-3 gap-3 border-t border-amber-200/50 max-w-lg mx-auto lg:mx-0">
            <div class="flex items-center gap-2 text-left">
              <CheckCircle2 className="size-4 text-emerald-600 shrink-0" />
              <span class="text-xs font-semibold text-stone-700">100% Organik</span>
            </div>
            <div class="flex items-center gap-2 text-left">
              <CheckCircle2 className="size-4 text-emerald-600 shrink-0" />
              <span class="text-xs font-semibold text-stone-700">Bebas Racun / BPA</span>
            </div>
            <div class="flex items-center gap-2 text-left">
              <CheckCircle2 className="size-4 text-emerald-600 shrink-0" />
              <span class="text-xs font-semibold text-stone-700">Garansi Tukar Size</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual Banner -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md rounded-4xl bg-linear-to-tr from-amber-100 via-orange-100 to-rose-100 p-6 sm:p-8 shadow-2xl border border-amber-200/70 overflow-hidden">
            <!-- Center illustration -->
            <div class="aspect-square rounded-3xl bg-white p-6 shadow-md flex flex-col items-center justify-center relative overflow-hidden">
              <img
                src="/images/products/piyama.svg"
                alt="CUBS Kids Hero"
                class="w-56 h-56 object-contain drop-shadow-md hover:scale-105 transition-transform duration-300"
              />
              <span class="mt-4 font-extrabold text-stone-800 text-lg">Piyama Katun Bambu Cubby</span>
              <span class="text-xs text-amber-700 font-semibold bg-amber-100 px-3 py-1 rounded-full mt-1">
                ⭐ 4.9 (480+ Terjual)
              </span>
            </div>

            <!-- Floating safety card top left -->
            <div class="absolute top-4 left-4 rounded-2xl bg-white/95 backdrop-blur-xs p-3 shadow-lg border border-amber-100 flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold">
                ✓
              </div>
              <div>
                <p class="text-xs font-bold text-stone-900">OEKO-TEX Certified</p>
                <p class="text-[10px] text-stone-500">Hypoallergenic Standard</p>
              </div>
            </div>

            <!-- Floating review pill bottom right -->
            <div class="absolute bottom-4 right-4 rounded-2xl bg-white/95 backdrop-blur-xs p-3 shadow-lg border border-amber-100 flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-base">
                🧸
              </div>
              <div>
                <p class="text-xs font-bold text-stone-900">1000+ Orang Tua Puas</p>
                <p class="text-[10px] text-amber-600 font-semibold">Ulasan Bintang 5</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-12 px-4 sm:px-6 bg-white border-y border-amber-100">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Koleksi Kategori Pilihan
        </h2>
        <p class="text-sm text-stone-600">
          Dirancang untuk berbagai tahapan usia si kecil, dari newborn hingga anak aktif.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {categories.map((c) => (
          <a
            href={c.href}
            class={`group relative rounded-3xl p-6 border transition-all duration-300 hover:shadow-lg hover:-translate-y-1 block ${c.bg}`}
          >
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">
              {c.icon}
            </div>
            <h3 class="font-bold text-lg text-stone-900 mb-1 flex items-center justify-between">
              <span>{c.title}</span>
              <ArrowRight className="size-4 opacity-0 group-hover:opacity-100 transition-opacity" />
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              {c.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products Section (From Keystatic) -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 bg-amber-100 px-3 py-1 rounded-full">
            <Sparkles className="size-3.5" />
            <span>Katalog Terupdate</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
            Produk Pilihan Si Kecil
          </h2>
          <p class="text-sm text-stone-600">
            Dikelola & dapat diupdate langsung melalui Keystatic CMS.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/products"
            class="inline-flex items-center gap-2 rounded-full bg-stone-900 hover:bg-stone-800 text-white text-xs sm:text-sm font-semibold px-5 py-2.5 transition-colors"
          >
            <span>Lihat Semua Katalog</span>
            <ArrowRight className="size-4" />
          </a>
        </div>
      </div>

      <!-- Grid of Featured Products -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Parents Choose CUBS -->
  <section class="py-16 px-4 sm:px-6 bg-linear-to-b from-amber-50/40 to-orange-50/40 border-y border-amber-100">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-semibold">
          <Award className="size-3.5" />
          <span>Komitmen Keamanan CUBS</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Mengapa Ribuan Bunda & Ayah Percaya pada CUBS?
        </h2>
        <p class="text-sm text-stone-600">
          Standar tinggi yang kami terapkan untuk setiap helai kain dan setiap sudut mainan.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-2xl">
            🌿
          </div>
          <h3 class="font-bold text-lg text-stone-900">100% Organik & Hypoallergenic</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Terbuat dari serat bambu dan katun organik pilihan yang secara alami memiliki sifat anti-bakteri, menyerap keringat 3x lebih cepat, dan tidak membuat kulit bayi iritasi.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-800 flex items-center justify-center text-2xl">
            🛡️
          </div>
          <h3 class="font-bold text-lg text-stone-900">Bebas Bahan Kimia Berbahaya</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Nol kandungan BPA, timbal, merkuri, dan ftalat. Mainan kayu dicat menggunakan pewarna berbahan dasar air ramah lingkungan yang aman meskipun tidak sengaja digigit anak.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-7 border border-amber-100 shadow-md space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-sky-100 text-sky-800 flex items-center justify-center text-2xl">
            👶
          </div>
          <h3 class="font-bold text-lg text-stone-900">Desain Ergonomis & Praktis</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Kerah fleksibel, kancing bebas nikel yang mudah dibuka saat ganti popok, dan potongan longgar yang memberi ruang bebas bagi si kecil untuk merangkak dan bergerak aktif.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Parent Testimonials -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-xl mx-auto mb-12 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Cerita Bunda & Ayah Bersama CUBS
        </h2>
        <p class="text-sm text-stone-600">
          Ulasan jujur dari keluarga yang telah merasakan kenyamanan produk kami.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="rounded-3xl bg-white p-6 border border-amber-100 shadow-md flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center gap-1 text-amber-400">
                {Array.from({ length: t.rating }).map(() => (
                  <Star className="size-4 fill-amber-400 stroke-amber-400" />
                ))}
              </div>
              <p class="text-sm text-stone-700 italic leading-relaxed">
                "{t.text}"
              </p>
            </div>

            <div class="flex items-center gap-3 pt-5 mt-4 border-t border-stone-100">
              <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-lg">
                {t.avatar}
              </div>
              <div>
                <h4 class="font-bold text-sm text-stone-900">{t.name}</h4>
                <p class="text-xs text-stone-500">{t.role} • {t.city}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section (Radix UI Accordion) -->
  <section class="py-16 px-4 sm:px-6 bg-white border-t border-amber-100">
    <FaqSection client:load />
  </section>

  <!-- Final CTA Banner -->
  <section class="py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl rounded-4xl bg-linear-to-r from-amber-400 via-orange-400 to-rose-400 p-8 sm:p-12 text-white shadow-xl shadow-orange-500/15 text-center space-y-6 relative overflow-hidden">
      <div class="pointer-events-none absolute -right-12 -top-12 w-48 h-48 rounded-full bg-white/10 blur-xl"></div>
      <div class="pointer-events-none absolute -left-12 -bottom-12 w-48 h-48 rounded-full bg-white/10 blur-xl"></div>

      <span class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-white/20 backdrop-blur-xs text-xs font-bold uppercase tracking-wider text-white">
        ✨ Siap Memberikan yang Terbaik untuk Si Kecil?
      </span>

      <h2 class="text-3xl sm:text-4xl font-black max-w-xl mx-auto leading-tight">
        Temukan Koleksi Pakaian & Mainan Aman Hari Ini
      </h2>

      <p class="text-sm sm:text-base text-amber-50 max-w-lg mx-auto">
        Dapatkan gratis ongkir dan konsultasi ukuran gratis langsung dengan tim CS kami.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/products"
          class="w-full sm:w-auto rounded-full bg-stone-900 hover:bg-stone-800 text-white font-bold text-sm px-8 py-3.5 shadow-md active:scale-98 transition-all"
        >
          Buka Katalog Produk
        </a>
        <a
          href="https://wa.me/6281234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto rounded-full bg-white hover:bg-stone-100 text-stone-900 font-bold text-sm px-8 py-3.5 shadow-md active:scale-98 transition-all"
        >
          Chat WhatsApp CS
        </a>
      </div>
    </div>
  </section>
</Layout>
