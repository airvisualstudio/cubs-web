---
import { Star, ShoppingCart, ArrowRight } from "lucide-react";
import { formatRupiah, CATEGORY_LABELS, AGE_LABELS, type ProductItem } from "../lib/keystatic";

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;
const entry = product.entry;
const slug = product.slug;

const categoryName = CATEGORY_LABELS[entry.category] || entry.category;
const ageName = AGE_LABELS[entry.ageGroup] || entry.ageGroup;
const discountPercent =
  entry.originalPrice && entry.originalPrice > entry.price
    ? Math.round(((entry.originalPrice - entry.price) / entry.originalPrice) * 100)
    : null;

const waMessage = encodeURIComponent(
  `Halo CUBS Kids, saya tertarik untuk memesan produk "${entry.name.replace(/-/g, ' ')}" seharga ${formatRupiah(entry.price)}. Apakah stok masih tersedia?`
);
const waLink = `https://wa.me/6281234567890?text=${waMessage}`;
---

<div class="group relative flex flex-col rounded-3xl bg-white border border-amber-100/80 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
  <!-- Image Container -->
  <a href={`/products/${slug}`} class="relative aspect-square w-full overflow-hidden bg-amber-50/50 block">
    {entry.image ? (
      <img
        src={entry.image}
        alt={entry.name}
        class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center text-5xl">
        🧸
      </div>
    )}

    <!-- Badge Promo / Label -->
    {entry.badge && (
      <div class="absolute top-3 left-3">
        <span class="inline-flex items-center gap-1 rounded-full bg-amber-500 text-white font-semibold text-xs px-3 py-1 shadow-sm">
          {entry.badge}
        </span>
      </div>
    )}

    <!-- Discount Pill -->
    {discountPercent && (
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center rounded-full bg-rose-500 text-white font-bold text-xs px-2.5 py-0.5 shadow-sm">
          -{discountPercent}%
        </span>
      </div>
    )}
  </a>

  <!-- Content Container -->
  <div class="flex flex-1 flex-col p-5">
    <!-- Category & Age Tag -->
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md">
        {categoryName}
      </span>
      <span class="text-xs text-stone-500 font-medium">
        {ageName}
      </span>
    </div>

    <!-- Product Title -->
    <h3 class="font-bold text-stone-900 text-base leading-snug line-clamp-2 hover:text-amber-700 transition-colors">
      <a href={`/products/${slug}`}>
        {entry.name.replace(/-/g, ' ')}
      </a>
    </h3>

    <!-- Material summary -->
    {entry.material && (
      <p class="text-xs text-stone-500 mt-1 line-clamp-1">
        ✨ {entry.material}
      </p>
    )}

    <!-- Rating & Sold Count -->
    <div class="flex items-center gap-2 mt-2.5">
      <div class="flex items-center gap-1 text-amber-500">
        <Star className="size-3.5 fill-amber-400 stroke-amber-400" />
        <span class="text-xs font-bold text-stone-800">{entry.rating || "4.9"}</span>
      </div>
      <span class="text-stone-300">•</span>
      <span class="text-xs text-stone-500">{entry.soldCount || 100}+ terjual</span>
    </div>

    <!-- Pricing Section -->
    <div class="mt-4 pt-3 border-t border-stone-100 flex items-baseline gap-2">
      <span class="text-lg font-extrabold text-stone-900">
        {formatRupiah(entry.price)}
      </span>
      {entry.originalPrice && (
        <span class="text-xs text-stone-400 line-through">
          {formatRupiah(entry.originalPrice)}
        </span>
      )}
    </div>

    <!-- Actions -->
    <div class="mt-4 grid grid-cols-2 gap-2">
      <a
        href={`/products/${slug}`}
        class="inline-flex items-center justify-center gap-1.5 rounded-full bg-stone-100 hover:bg-amber-100 text-stone-700 hover:text-amber-900 text-xs font-semibold py-2.5 px-3 transition-colors text-center"
      >
        <span>Detail</span>
        <ArrowRight className="size-3.5" />
      </a>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold py-2.5 px-3 shadow-xs hover:shadow-sm transition-all text-center"
      >
        <ShoppingCart className="size-3.5" />
        <span>Pesan</span>
      </a>
    </div>
  </div>
</div>

