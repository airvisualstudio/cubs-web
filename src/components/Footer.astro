---
import { getContact } from "../lib/keystatic";
import {
  Heart,
  Sparkles,
  ShieldCheck,
  Truck,
  RefreshCw,
  Phone,
  Mail,
  MapPin,
} from "lucide-react";

const contact = await getContact();
---

<footer class="mt-20 border-t border-stone-200/60 bg-[#FDFBF7] pt-16 pb-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Top Feature / Trust Bar -->
    <div
      class="mb-12 grid grid-cols-2 md:grid-cols-4 gap-6 pb-12 border-b border-stone-200/60"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0"
        >
          <ShieldCheck className="size-6" />
        </div>
        <div>
          <h4 class="font-bold text-sm text-stone-900">100% Katun Adem</h4>
          <p class="text-xs text-stone-500">Standar katun combed 24s & bambu</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div
          class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0"
        >
          <Heart className="size-6" />
        </div>
        <div>
          <h4 class="font-bold text-sm text-stone-900">Bebas Label Gatal</h4>
          <p class="text-xs text-stone-500">
            Tagless, aman untuk kulit sensitif
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div
          class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0"
        >
          <Truck className="size-6" />
        </div>
        <div>
          <h4 class="font-bold text-sm text-stone-900">Pengiriman Cepat</h4>
          <p class="text-xs text-stone-500">
            Kirim di hari yang sama se-Indonesia
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div
          class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center shrink-0"
        >
          <RefreshCw className="size-6" />
        </div>
        <div>
          <h4 class="font-bold text-sm text-stone-900">Garansi Tukar Size</h4>
          <p class="text-xs text-stone-500">7 hari retur jika size tidak pas</p>
        </div>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand column -->
      <div class="md:col-span-1 space-y-4">
        <p class="text-sm text-stone-600 leading-relaxed">
          Koleksi pakaian anak usia 3 hingga 8 tahun yang dirancang khusus untuk
          kenyamanan si kecil yang aktif bergerak. Bahannya sejuk, menyerap
          keringat, dan tahan cuci berulang kali.
        </p>
      </div>

      <!-- Navigation links -->
      <div>
        <h4
          class="font-bold text-stone-900 mb-4 text-sm uppercase tracking-wider"
        >
          Navigasi Cepat
        </h4>
        <ul class="space-y-2.5 text-sm text-stone-600">
          <li>
            <a href="/" class="hover:text-amber-700 transition-colors"
              >Beranda (Home)</a
            >
          </li>
          <li>
            <a href="/about" class="hover:text-amber-700 transition-colors"
              >Tentang Kami (About)</a
            >
          </li>
          <li>
            <a href="/products" class="hover:text-amber-700 transition-colors"
              >Katalog Baju (Product)</a
            >
          </li>
          <li>
            <a href="/contact" class="hover:text-amber-700 transition-colors"
              >Kontak & Panduan Ukuran</a
            >
          </li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h4
          class="font-bold text-stone-900 mb-4 text-sm uppercase tracking-wider"
        >
          Kategori Baju Anak
        </h4>
        <ul class="space-y-2.5 text-sm text-stone-600">
          <li>
            <a
              href="/products?category=atasan"
              class="hover:text-amber-700 transition-colors"
              >Kaos & Atasan Santai</a
            >
          </li>
          <li>
            <a
              href="/products?category=setelan"
              class="hover:text-amber-700 transition-colors"
              >Setelan & Piyama Bambu</a
            >
          </li>
          <li>
            <a
              href="/products?category=dress"
              class="hover:text-amber-700 transition-colors"
              >Dress & Terusan Anak Perempuan</a
            >
          </li>
          <li>
            <a
              href="/products?category=bawahan-outer"
              class="hover:text-amber-700 transition-colors"
              >Jaket Hoodie & Celana Jogger</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact Info (Dynamic from Keystatic) -->
      <div class="space-y-3">
        <h4
          class="font-bold text-stone-900 mb-4 text-sm uppercase tracking-wider"
        >
          Layanan Pelanggan
        </h4>
        <div class="flex items-start gap-2.5 text-sm text-stone-600">
          <MapPin className="size-4 text-amber-600 shrink-0 mt-0.5" />
          <span>{contact.address}</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm text-stone-600">
          <Phone className="size-4 text-amber-600 shrink-0" />
          <a
            href={contact.whatsappUrl || `https://wa.me/${(contact.whatsapp || "").replace(/[^0-9]/g, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-emerald-700 transition-colors"
          >
            WhatsApp: {contact.whatsapp}
          </a>
        </div>
        <div class="flex items-center gap-2.5 text-sm text-stone-600">
          <Mail className="size-4 text-amber-600 shrink-0" />
          <a
            href={`mailto:${contact.email}`}
            class="hover:text-emerald-700 transition-colors"
          >
            {contact.email}
          </a>
        </div>
        {contact.operationalHours && (
          <p class="text-xs text-stone-500 pt-2">
            Jam Operasional: {contact.operationalHours}
          </p>
        )}
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div
      class="mt-12 pt-8 border-t border-stone-200/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500"
    >
      <p>
        © {new Date().getFullYear()} CUBS - Bright Wear for Little Adventurers. Hak
        Cipta Dilindungi.
      </p>
      <div class="flex items-center gap-4">
        <span>Dibuat dengan ❤️ untuk Senyuman & Keaktifan Si Kecil</span>
      </div>
    </div>
  </div>
</footer>
