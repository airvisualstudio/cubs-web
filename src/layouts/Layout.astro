---
import "../styles/global.css";
import { Navbar } from "../components/Navbar";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CUBS Kids - Koleksi Perlengkapan, Pakaian & Mainan Anak Aman & Ceria",
  description = "Koleksi produk anak pilihan berbahan organik dan aman bersertifikasi. Pakaian, mainan edukasi, dan perlengkapan si kecil terlengkap.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-[#fcfaf7] text-stone-800 antialiased min-h-screen flex flex-col font-sans selection:bg-amber-200 selection:text-amber-900">
    <!-- Floating Rounded Navbar -->
    <Navbar currentPath={currentPath} client:load />

    <!-- Main Content Area with top offset for the floating navbar -->
    <main class="flex-1 pt-24 sm:pt-28">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
