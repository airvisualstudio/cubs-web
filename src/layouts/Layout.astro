---
import "../styles/global.css";
import { Navbar } from "../components/Navbar";
import { ConsultationFab } from "../components/ConsultationFab";
import Footer from "../components/Footer.astro";
import { getContact } from "../lib/keystatic";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CUBS - Bright Wear for Little Adventurers",
  description = "Koleksi produk anak pilihan berbahan organik dan aman bersertifikasi. Pakaian, mainan edukasi, dan perlengkapan si kecil terlengkap.",
} = Astro.props;

const contact = await getContact();
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body
    class="bg-[#fcfaf7] text-stone-800 antialiased min-h-screen flex flex-col font-sans selection:bg-amber-200 selection:text-amber-900"
  >
    <!-- Floating Rounded Navbar -->
    <Navbar currentPath={currentPath} whatsappNumber={contact.whatsapp || undefined} client:load />

    <!-- Main Content Area: Zero top padding on Home so full-bleed Jumbotron goes all the way to the top -->
    <main class={`flex-1 ${isHome ? "pt-0" : "pt-18 sm:pt-22"}`}>
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Floating Action Button (FAB) Konsultasi Ukuran & Model -->
    <ConsultationFab whatsappNumber={contact.whatsapp || undefined} client:load />
  </body>
</html>
