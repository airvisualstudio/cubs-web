---
import "../styles/global.css";
const { title } = Astro.props;
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="mx-auto max-w-5xl p-6">
		<header class="mb-8 border-b pb-4">
			<a href="/" class="text-xl font-bold">Nama Toko</a>
		</header>
		<slot />
		<footer class="mt-12 border-t pt-4 text-sm text-gray-500">
			© {new Date().getFullYear()} Nama Toko
		</footer>
	</body>
</html>
